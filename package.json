{
  "name": "bot-commander-desktop",
  "version": "1.6.0",
  "description": "An application allowing the creation and hosting of bots for Discord",
  "main": "./out/main/index.js",
  "author": "ayayaQ",
  "homepage": "https://github.com/ayayaQ/bot-commander-desktop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-help-docs.mjs",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron --no && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "acorn": "^8.18.0",
    "discord.js": "^14.27.0",
    "marked": "^18.0.9",
    "openai": "^7.4.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "cheerio": "^1.2.0",
    "daisyui": "^5.5.14",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ws": "8.21.1",
    "@electron/get": {
      "undici": "7.29.0"
    }
  }
}
